<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- e2e/ai-show.sh: a model answer from adb instead of the model (the emulator cannot run it). DUMP is a
             system permission that adb's shell holds and no installed app can get, so only adb can start it. -->
        <activity
            android:name="me.zhanghai.android.files.ai.DebugAiActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.MaterialFiles" />
        <!-- Test phones only: a moving idle screen started by adb while a phone waits (no burn-in). -->
        <activity
            android:name="me.zhanghai.android.files.dev.DebugIdleActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
