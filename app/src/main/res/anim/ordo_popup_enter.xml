<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@interpolator/ordo_emphasized">
    <!-- Centre pivot: the platform cannot tell a custom style whether the menu opens up or down. -->
    <scale android:duration="140" android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="140" android:fromAlpha="0" android:toAlpha="1" />
</set>
