<!-- Tiles fade and rise in one after another when the home screen first appears. A plain
     layoutAnimation, since RecyclerView does not provide grid animation parameters. -->
<layoutAnimation xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/home_item_enter"
    android:animationOrder="normal"
    android:delay="10%" />
