<resources>

    <attr name="colorAppBarSurface" format="color" />

    <declare-styleable name="AspectRatioFrameLayout">
        <attr name="aspectRatio" format="float" />
    </declare-styleable>

    <declare-styleable name="NavigationViewExtra">
        <attr name="itemSubtitleTextAppearance" format="reference" />
        <attr name="itemSubtitleTextColor" format="color" />
        <attr name="itemSubtitleTextSize" format="dimension" />
        <attr name="dividerVerticalPadding" format="dimension" />
    </declare-styleable>

    <declare-styleable name="SettingsCategoryPreference">
        <!-- Colour of the round pictogram background; a second colour makes it a gradient. -->
        <attr name="ordoCircleColor" format="color" />
        <attr name="ordoCircleColorEnd" format="color" />
    </declare-styleable>

    <!-- WavySlider (from Auxio): the attributes are MDC's own wave attributes of the progress indicators. -->
    <declare-styleable name="WavySlider">
        <attr name="wavelength" />
        <attr name="waveAmplitude" />
        <attr name="waveSpeed" />
        <attr name="waveAmplitudeRampProgressMax" />
        <attr name="waveAmplitudeRampProgressMin" />
    </declare-styleable>
</resources>
