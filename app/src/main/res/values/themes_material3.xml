        <item name="colorOnSecondaryContainer">@color/ordo_on_secondary_container</item>
        <item name="colorTertiary">@color/ordo_tertiary</item>
        <item name="colorSurface">@color/ordo_surface</item>
        <item name="colorOnSurface">@color/ordo_on_surface</item>
        <item name="colorSurfaceVariant">@color/ordo_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ordo_on_surface_variant</item>
        <item name="android:textColorSecondary">@color/ordo_secondary_text</item>
        <item name="colorOutline">@color/ordo_outline</item>
