        <item name="actionBarSize">56dp</item>
        <item name="appBarLayoutStyle">@style/Widget.Ordo.AppBarLayout</item>
        <item name="colorPrimaryDark">@color/system_window_scrim_material3</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
    </style>
    <style name="Platform.Theme.MaterialFiles.Material3" parent="Platform.V23.Theme.MaterialFiles.Material3" />
    <style name="Base.Theme.MaterialFiles.Material3" parent="Platform.Theme.MaterialFiles.Material3">

        <item name="actionBarTheme">@style/ThemeOverlay.MaterialFiles.ActionBar</item>
