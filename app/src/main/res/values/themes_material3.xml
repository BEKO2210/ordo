        <item name="colorOnTertiary">@color/ordo_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ordo_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ordo_on_tertiary_container</item>
        <item name="colorOnError">@color/ordo_on_error</item>
        <item name="colorErrorContainer">@color/ordo_error_container</item>
        <item name="colorOnErrorContainer">@color/ordo_on_error_container</item>
