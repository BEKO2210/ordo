<resources>

    <style name="Platform.V23.Theme.MaterialFiles.Material3" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Owner's rule: a word never breaks in the middle anywhere in the app, so no automatic hyphenation;
             a label that does not fit has to size, stack or shorten itself instead. -->
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:breakStrategy">simple</item>
        <!-- Fixed Ordo colours instead of wallpaper-based dynamic colour (ordo_m3_colors.xml). -->
        <item name="colorPrimary">@color/ordo_primary</item>
        <item name="colorOnPrimary">@color/ordo_on_primary</item>
        <item name="colorPrimaryContainer">@color/ordo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ordo_on_primary_container</item>
        <item name="colorSecondary">@color/ordo_secondary</item>
