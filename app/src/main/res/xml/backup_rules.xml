<!-- Android 11 and older. The settings hold server passwords and keys, so they never leave the phone. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
