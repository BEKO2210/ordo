<!-- Ordo Video's settings (its library's menu). Lists and switches only, no sliders (house rule); every row has a
     symbol (house rule: never text only); each row's summary shows its value; switch titles wrap instead of ending
     in "…" (S21). What each value does: viewer/video/VideoPrefs.kt and the player/library code that reads it. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_section_appearance">

        <me.zhanghai.android.files.settings.AppAccentPreference
            android:key="@string/pref_key_video_accent"
            android:icon="@drawable/palette_icon_white_24dp"
            android:title="@string/settings_app_accent_title"
            android:defaultValue="@string/pref_default_value_app_accent" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_playback">
        <ListPreference
            android:key="@string/pref_key_video_end"
            android:icon="@drawable/audio_track_end_icon_24dp"
            android:title="@string/video_settings_end"
            android:defaultValue="@string/pref_default_value_video_end"
            android:entries="@array/video_settings_end_entries"
            android:entryValues="@array/pref_entry_values_video_end"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_resume"
            android:icon="@drawable/restart_icon_white_24dp"
            android:title="@string/video_settings_resume"
            android:defaultValue="@string/pref_default_value_video_resume"
            android:entries="@array/video_settings_resume_entries"
            android:entryValues="@array/pref_entry_values_video_resume"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_speed"
            android:icon="@drawable/audio_speed_icon_24dp"
            android:title="@string/video_settings_speed"
            android:defaultValue="@string/pref_default_value_video_speed"
            android:entries="@array/video_settings_speed_entries"
            android:entryValues="@array/pref_entry_values_video_speed"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_jump"
            android:icon="@drawable/video_forward_10_icon_24dp"
            android:title="@string/video_settings_jump"
            android:defaultValue="@string/pref_default_value_video_jump"
            android:entries="@array/video_settings_jump_entries"
            android:entryValues="@array/pref_entry_values_video_jump"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_resize"
            android:icon="@drawable/video_aspect_ratio_icon_24dp"
            android:title="@string/video_settings_resize"
            android:defaultValue="@string/pref_default_value_video_resize"
            android:entries="@array/video_settings_resize_entries"
            android:entryValues="@array/pref_entry_values_video_resize"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_orientation"
            android:icon="@drawable/video_screen_rotation_icon_24dp"
            android:title="@string/video_settings_orientation"
            android:defaultValue="@string/pref_default_value_video_orientation"
            android:entries="@array/video_settings_orientation_entries"
            android:entryValues="@array/pref_entry_values_video_orientation"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_keep_screen_on"
            android:icon="@drawable/settings_video_keep_screen_on_icon_white_24dp"
            android:title="@string/video_settings_keep_screen_on"
            android:summary="@string/video_settings_keep_screen_on_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <ListPreference
            android:key="@string/pref_key_video_background"
            android:icon="@drawable/audio_headphones_icon_24dp"
            android:title="@string/video_settings_background"
            android:defaultValue="@string/pref_default_value_video_background"
            android:entries="@array/video_settings_background_entries"
            android:entryValues="@array/pref_entry_values_video_background"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_pip"
            android:icon="@drawable/video_pip_icon_24dp"
            android:title="@string/video_settings_pip"
            android:summary="@string/video_settings_pip_summary"
            android:defaultValue="@bool/pref_default_value_true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_picture">
        <ListPreference
            android:key="@string/pref_key_video_picture"
            android:icon="@drawable/video_enhance_icon_24dp"
            android:title="@string/video_settings_picture"
            android:defaultValue="@string/pref_default_value_video_picture"
            android:entries="@array/video_settings_picture_entries"
            android:entryValues="@array/pref_entry_values_video_picture"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_upscaler"
            android:icon="@drawable/settings_video_upscaler_icon_white_24dp"
            android:title="@string/video_settings_upscaler"
            android:defaultValue="@string/pref_default_value_video_upscaler"
            android:entries="@array/video_settings_upscaler_entries"
            android:entryValues="@array/pref_entry_values_video_upscaler"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_frame_rate"
            android:icon="@drawable/audio_timer_icon_24dp"
            android:title="@string/video_settings_frame_rate"
            android:defaultValue="@string/pref_default_value_video_frame_rate"
            android:entries="@array/video_settings_frame_rate_entries"
            android:entryValues="@array/pref_entry_values_video_frame_rate"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_ambient_gamma"
            android:icon="@drawable/settings_video_ambient_gamma_icon_white_24dp"
            android:title="@string/video_settings_ambient_gamma"
            android:summary="@string/video_settings_ambient_gamma_summary"
            android:defaultValue="@bool/pref_default_value_false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_gestures">
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_gesture_brightness"
            android:icon="@drawable/settings_video_brightness_icon_white_24dp"
            android:title="@string/video_settings_g_brightness"
            android:summary="@string/video_settings_g_brightness_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_gesture_volume"
            android:icon="@drawable/audio_volume_icon_24dp"
            android:title="@string/video_settings_g_volume"
            android:summary="@string/video_settings_g_volume_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_gesture_seek"
            android:icon="@drawable/video_seek_frame_ahead_icon_24dp"
            android:title="@string/video_settings_g_seek"
            android:summary="@string/video_settings_g_seek_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_gesture_double_tap"
            android:icon="@drawable/settings_video_double_tap_icon_white_24dp"
            android:title="@string/video_settings_g_double_tap"
            android:summary="@string/video_settings_g_double_tap_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_gesture_hold"
            android:icon="@drawable/settings_video_hold_icon_white_24dp"
            android:title="@string/video_settings_g_hold"
            android:summary="@string/video_settings_g_hold_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <ListPreference
            android:key="@string/pref_key_video_hold_speed"
            android:icon="@drawable/audio_fast_forward_icon_24dp"
            android:title="@string/video_settings_hold_speed"
            android:defaultValue="@string/pref_default_value_video_hold_speed"
            android:entries="@array/video_settings_hold_speed_entries"
            android:entryValues="@array/pref_entry_values_video_hold_speed"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_remember_brightness"
            android:icon="@drawable/settings_video_brightness_icon_white_24dp"
            android:title="@string/video_settings_remember_brightness"
            android:summary="@string/video_settings_remember_brightness_summary"
            android:defaultValue="@bool/pref_default_value_false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_sound">
        <ListPreference
            android:key="@string/pref_key_video_audio_language"
            android:icon="@drawable/audio_icon_white_24dp"
            android:title="@string/video_settings_audio_language"
            android:defaultValue="@string/pref_default_value_video_audio_language"
            android:entries="@array/video_settings_audio_language_entries"
            android:entryValues="@array/pref_entry_values_video_audio_language"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_subtitles">
        <ListPreference
            android:key="@string/pref_key_video_subtitle_language"
            android:icon="@drawable/settings_language_icon_white_24dp"
            android:title="@string/video_settings_subtitle_language"
            android:defaultValue="@string/pref_default_value_video_subtitle_language"
            android:entries="@array/video_settings_subtitle_language_entries"
            android:entryValues="@array/pref_entry_values_video_subtitle_language"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_subtitles_auto"
            android:icon="@drawable/video_subtitles_icon_24dp"
            android:title="@string/video_settings_subtitles_auto"
            android:summary="@string/video_settings_subtitles_auto_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <ListPreference
            android:key="@string/pref_key_video_subtitle_reading"
            android:icon="@drawable/settings_video_reading_icon_white_24dp"
            android:title="@string/video_settings_subtitle_reading"
            android:defaultValue="@string/pref_default_value_video_subtitle_reading"
            android:entries="@array/video_settings_subtitle_reading_entries"
            android:entryValues="@array/pref_entry_values_video_subtitle_reading"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_subtitle_slow_down"
            android:icon="@drawable/settings_video_slow_motion_icon_white_24dp"
            android:title="@string/video_settings_subtitle_slow_down"
            android:summary="@string/video_settings_subtitle_slow_down_summary"
            android:defaultValue="@bool/pref_default_value_false" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_subtitle_sounds"
            android:icon="@drawable/audio_hearing_icon_24dp"
            android:title="@string/video_settings_subtitle_sounds"
            android:summary="@string/video_settings_subtitle_sounds_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_subtitle_speaker_colors"
            android:icon="@drawable/palette_icon_white_24dp"
            android:title="@string/video_settings_subtitle_speaker_colors"
            android:summary="@string/video_settings_subtitle_speaker_colors_summary"
            android:defaultValue="@bool/pref_default_value_true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_library">
        <ListPreference
            android:key="@string/pref_key_video_sort"
            android:icon="@drawable/sort_icon_control_normal_24dp"
            android:title="@string/video_settings_sort"
            android:defaultValue="@string/pref_default_value_video_sort"
            android:entries="@array/video_settings_sort_entries"
            android:entryValues="@array/pref_entry_values_video_sort"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="@string/pref_key_video_view"
            android:icon="@drawable/settings_tile_icon_white_24dp"
            android:title="@string/video_settings_view"
            android:defaultValue="@string/pref_default_value_video_view"
            android:entries="@array/video_settings_view_entries"
            android:entryValues="@array/pref_entry_values_video_view"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_show_continue"
            android:icon="@drawable/video_autoplay_icon_24dp"
            android:title="@string/video_settings_show_continue"
            android:summary="@string/video_settings_show_continue_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_camera_names"
            android:icon="@drawable/camera_icon_white_24dp"
            android:title="@string/video_settings_camera_names"
            android:summary="@string/video_settings_camera_names_summary"
            android:defaultValue="@bool/pref_default_value_true" />
        <MultiSelectListPreference
            android:key="@string/pref_key_video_hidden_folders"
            android:icon="@drawable/directory_icon_white_24dp"
            android:title="@string/video_settings_hidden_folders"
            android:defaultValue="@array/pref_default_value_video_hidden_folders" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/video_settings_cat_privacy">

        <Preference
            android:key="video_clear_history"
            android:icon="@drawable/delete_icon_white_24dp"
            android:title="@string/video_settings_clear_history"
            android:summary="@string/video_settings_clear_history_summary" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="@string/pref_key_video_no_history"
            android:icon="@drawable/history_icon_white_24dp"
            android:title="@string/video_settings_no_history"
            android:summary="@string/video_settings_no_history_summary"
            android:defaultValue="@bool/pref_default_value_false" />
    </PreferenceCategory>
</PreferenceScreen>
