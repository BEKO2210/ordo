<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="@string/pref_key_trash_enabled"
        android:title="@string/settings_trash_enabled_title"
        android:summary="@string/settings_trash_enabled_summary"
        android:defaultValue="@bool/pref_default_value_trash_enabled" />

    <ListPreference
        android:key="@string/pref_key_trash_retention_days"
        android:title="@string/settings_trash_retention_title"
        android:defaultValue="@string/pref_default_value_trash_retention_days"
        android:dependency="@string/pref_key_trash_enabled"
        android:entries="@array/settings_trash_retention_entries"
        android:entryValues="@array/pref_entry_values_trash_retention_days"
        app:useSimpleSummaryProvider="true" />
</PreferenceScreen>
