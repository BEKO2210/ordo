    <PreferenceCategory android:title="@string/settings_group_more">

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="link_legal"
            android:icon="@drawable/legal_icon_white_24dp"
            android:title="@string/legal_title"
            android:summary="@string/settings_link_legal_summary"
            app:ordoCircleColor="#475569" />

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="link_about"
            android:icon="@drawable/about_icon_white_24dp"
            android:title="@string/navigation_about"
            android:summary="@string/navigation_about"
            app:ordoCircleColor="#64748B" />
