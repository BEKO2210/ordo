<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_group_general">

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="section_appearance"
            android:icon="@drawable/palette_icon_white_24dp"
            android:title="@string/settings_section_appearance"
            android:summary="@string/settings_section_appearance_summary"
            app:ordoCircleColor="#D97706" />

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="section_ai"
            android:icon="@drawable/assistant_icon_white_24dp"
            android:title="@string/settings_section_ai"
            android:summary="@string/settings_section_ai_summary"
            app:ordoCircleColor="#0891B2"
            app:ordoCircleColorEnd="#4F46E5" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_files">

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="section_files"
            android:icon="@drawable/directory_icon_white_24dp"
            android:title="@string/settings_section_files"
            android:summary="@string/settings_section_files_summary"
            app:ordoCircleColor="#2563EB" />

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="section_storage"
            android:icon="@drawable/device_icon_white_24dp"
            android:title="@string/settings_section_storage"
            android:summary="@string/settings_section_storage_summary"
            app:ordoCircleColor="#0D9488" />

        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="section_trash"
            android:icon="@drawable/delete_icon_white_24dp"
