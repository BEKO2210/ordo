        <me.zhanghai.android.files.settings.SettingsCategoryPreference
            android:key="link_ftp_server"
            android:icon="@drawable/shared_directory_icon_white_24dp"
            android:title="@string/navigation_ftp_server"
            android:summary="@string/settings_link_ftp_server_summary"
            app:ordoCircleColor="#EA580C" />
