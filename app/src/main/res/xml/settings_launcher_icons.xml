<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="launcher_icons_info"
        android:selectable="false"
        android:summary="@string/launcher_icons_info" />

    <SwitchPreferenceCompat
        android:key="launcher_music"
        android:icon="@drawable/audio_icon_white_24dp"
        android:title="@string/launcher_music_label"
        android:summary="@string/launcher_music_summary"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="launcher_video"
        android:icon="@drawable/video_icon_white_24dp"
        android:title="@string/launcher_video_label"
        android:summary="@string/launcher_coming_soon"
        android:enabled="false"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="launcher_images"
        android:icon="@drawable/image_icon_white_24dp"
        android:title="@string/launcher_images_label"
        android:summary="@string/launcher_coming_soon"
        android:enabled="false"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="launcher_pdf"
        android:icon="@drawable/document_icon_white_24dp"
        android:title="@string/launcher_pdf_label"
        android:summary="@string/launcher_coming_soon"
        android:enabled="false"
        android:persistent="false" />

    <SwitchPreferenceCompat
        android:key="launcher_notes"
        android:icon="@drawable/text_file_icon_white_24dp"
        android:title="@string/launcher_notes_label"
        android:summary="@string/launcher_coming_soon"
        android:enabled="false"
        android:persistent="false" />
</PreferenceScreen>
