<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded landscape windows use two generous panes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?actionBarSize" android:background="@android:color/transparent"
        android:title="@string/audio_player_title" android:theme="?actionBarTheme"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/close_icon_control_normal_24dp"
        app:popupTheme="?actionBarPopupTheme" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="16dp">
        <FrameLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85">
            <me.zhanghai.android.files.ui.AspectRatioFrameLayout
                android:id="@+id/artworkContainer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center" android:tag="split"
                android:clipChildren="false" android:clipToPadding="false"
                app:aspectRatio="1">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/artworkCard" android:layout_width="match_parent"
                    android:layout_height="match_parent" app:cardBackgroundColor="?colorSurfaceVariant"
                    app:cardCornerRadius="28dp" app:cardElevation="6dp" app:strokeWidth="0dp">
                    <ImageView android:id="@+id/artwork" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:contentDescription="@null"
                        android:importantForAccessibility="no" android:scaleType="centerInside" />
                </com.google.android.material.card.MaterialCardView>
            </me.zhanghai.android.files.ui.AspectRatioFrameLayout>
        </FrameLayout>
        <Space android:layout_width="24dp" android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15"
            android:gravity="center_vertical" android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/title" style="@style/Widget.Ordo.AudioPlayer.Title"
                android:gravity="start" />
            <TextView android:id="@+id/artist" style="@style/Widget.Ordo.AudioPlayer.Subtitle"
                android:layout_marginTop="8dp" android:gravity="start" />
            <TextView android:id="@+id/album" style="@style/Widget.Ordo.AudioPlayer.Subtitle"
                android:gravity="start" android:visibility="gone" />
            <SeekBar android:id="@+id/seekBar" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="24dp"
                android:contentDescription="@string/audio_player_position" android:max="1000"
                android:paddingStart="0dp" android:paddingEnd="0dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/elapsed" style="@style/Widget.Ordo.AudioPlayer.Time" android:text="0:00" />
                <TextView android:id="@+id/remaining" style="@style/Widget.Ordo.AudioPlayer.Time"
                    android:gravity="end" android:text="−0:00" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="@dimen/audio_player_transport_row_height"
                android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
                <FrameLayout android:layout_width="48dp" android:layout_height="56dp">
                    <ImageButton android:id="@+id/shuffle" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                        android:accessibilityLiveRegion="polite" android:contentDescription="@string/audio_player_shuffle"
                        android:src="@drawable/shuffle_icon_24dp" />
                    <View android:id="@+id/shuffleIndicator" android:layout_width="4dp" android:layout_height="4dp"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="2dp"
                        android:background="@drawable/audio_player_active_indicator" android:visibility="gone" />
                </FrameLayout>
                <Space android:layout_width="4dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/previous" style="@style/Widget.Ordo.AudioPlayer.SkipControl"
                    android:contentDescription="@string/audio_player_previous" android:src="@drawable/skip_previous_icon_24dp" />
                <Space android:layout_width="4dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/playPause" style="@style/Widget.Ordo.AudioPlayer.PrimaryControl"
                    android:contentDescription="@string/audio_player_play" android:src="@drawable/play_icon_24dp" />
                <Space android:layout_width="4dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/next" style="@style/Widget.Ordo.AudioPlayer.SkipControl"
                    android:contentDescription="@string/audio_player_next" android:src="@drawable/skip_next_icon_24dp" />
                <Space android:layout_width="4dp" android:layout_height="1dp" />
                <FrameLayout android:layout_width="48dp" android:layout_height="56dp">
                    <ImageButton android:id="@+id/repeat" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                        android:accessibilityLiveRegion="polite" android:contentDescription="@string/audio_player_repeat"
                        android:src="@drawable/repeat_icon_24dp" />
                    <View android:id="@+id/repeatIndicator" android:layout_width="4dp" android:layout_height="4dp"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="2dp"
                        android:background="@drawable/audio_player_active_indicator" android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
