<!-- Lid lifts, tilts, drops back. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="can"
                android:fillColor="@android:color/white"
                android:pathData="M7,9.2h10v9.3c0,1-0.8,1.8-1.8,1.8H8.8c-1,0-1.8-0.8-1.8-1.8V9.2z" />
            <group
                android:name="lid"
                android:pivotX="12"
                android:pivotY="7.2"
                android:rotation="0"
                android:translateY="0">
                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M5.2,7.2h13.6c0.5,0 0.9,0.4 0.9,0.9v0.2H4.3V8.1c0-0.5 0.4-0.9 0.9-0.9z" />
                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M9.2,4.6h5.6c0.6,0 1.1,0.5 1.1,1.1V7.2H8.1V5.7c0-0.6 0.5-1.1 1.1-1.1z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="lid">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="220"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-2.2"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="220"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="80"
                    android:valueFrom="0"
                    android:valueTo="14"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:startOffset="260"
                    android:valueFrom="-2.2"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="260"
                    android:valueFrom="14"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
