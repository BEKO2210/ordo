<!-- Folder flap opens a little and settles shut. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="body"
                android:fillColor="@android:color/white"
                android:pathData="M3.5,9h6l1.7,1.8H20c0.8,0 1.5,0.7 1.5,1.5v7.2c0,0.8-0.7,1.5-1.5,1.5H3.5c-0.8,0-1.5-0.7-1.5-1.5v-9c0-0.8 0.7-1.5 1.5-1.5z" />
            <group
                android:name="flap"
                android:pivotX="4"
                android:pivotY="9"
                android:rotation="0">
                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M3.5,5.8h6.2l1.8,1.8H3.5c-0.8,0-1.5,0.5-1.5,1.4V9h1.5V7.6c0-0.3 0.2-0.5 0.5-0.5h5.3L8.8,5.8H4c-0.3,0-0.5,0.2-0.5,0.5z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="flap">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="280"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="-16"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="-16"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
