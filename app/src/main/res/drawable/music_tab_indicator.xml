<!-- The music tabs' selection: a One UI pill as wide as the tab (13 dp around icon and label), 5 dp above and below it
     inside the 48 dp target, so neighbouring pills never overlap; TabLayout tints it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="@dimen/phi_5"
    android:insetLeft="0dp"
    android:insetRight="0dp"
    android:insetTop="@dimen/phi_5">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/phi_34" />
        <solid android:color="@android:color/white" />
    </shape>
</inset>
