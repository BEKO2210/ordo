    android:insetBottom="@dimen/phi_5"
    android:insetLeft="@dimen/phi_5"
    android:insetRight="@dimen/phi_5"
    android:insetTop="@dimen/phi_5">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/phi_34" />
        <solid android:color="@android:color/white" />
    </shape>
</inset>
