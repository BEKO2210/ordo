<!-- The side menu in the page tone (black in the black night mode); a hairline marks its edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:colorBackground" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:gravity="end">
        <shape android:shape="rectangle">
            <solid android:color="@color/ordo_hairline" />
        </shape>
    </item>
</layer-list>
