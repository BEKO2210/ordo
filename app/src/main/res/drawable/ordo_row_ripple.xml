<!-- Touch feedback for list rows: an accent-tinted ripple inside a rounded, inset shape instead of a full-width flash. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?colorControlHighlight">
    <item android:id="@android:id/mask">
        <inset
            android:insetBottom="@dimen/phi_3"
            android:insetLeft="@dimen/phi_8"
            android:insetRight="@dimen/phi_8"
            android:insetTop="@dimen/phi_3">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/phi_radius_l" />
                <solid android:color="@android:color/white" />
            </shape>
        </inset>
    </item>
</ripple>
