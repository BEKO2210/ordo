<!-- A 48 dp cover with rounded corners; the symbol shows until (and unless) a cover loads over it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:importantForAccessibility="no"
    app:cardBackgroundColor="?colorSurfaceVariant"
    app:cardCornerRadius="@dimen/phi_radius_s"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/audio_icon_white_24dp"
        app:tint="?colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
</com.google.android.material.card.MaterialCardView>
