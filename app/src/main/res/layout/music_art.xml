<!-- A cover with rounded corners (48 dp unless the includer sizes it). One picture, or a collage of up to four album
     covers for an artist or a folder; the name's placeholder shows wherever a cover is missing. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:importantForAccessibility="no"
    app:cardBackgroundColor="?colorSurfaceVariant"
    app:cardCornerRadius="@dimen/phi_radius_s"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/collage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cell1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/cell2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cell3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/cell4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </LinearLayout>

    <!-- Over the cover of the song that is playing: a dimmed cover with moving bars. -->
    <me.zhanghai.android.files.viewer.audio.EqualizerBarsView
        android:id="@+id/bars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- A selected song (long press): the cover dimmed in the accent colour with a check. -->
    <ImageView
        android:id="@+id/selected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorPrimary"
        android:importantForAccessibility="no"
        android:padding="@dimen/phi_13"
        android:src="@drawable/check_circle_icon_white_24dp"
        android:visibility="gone"
        app:tint="?colorOnPrimary" />
</com.google.android.material.card.MaterialCardView>
