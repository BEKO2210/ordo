<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- As in the file list, a swipe to the right anywhere on the page opens the side menu. -->
    <me.zhanghai.android.files.ui.IgnoreFitsSystemWindowsFullyDraggableDrawerContentLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- The content scrolls under the glass search bar (top or bottom, see Settings), which blurs it. -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.ThemedSwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/permissionCard"
                    style="@style/Widget.MaterialFiles.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_gutter">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_card_h"
                        android:paddingVertical="@dimen/space_card_v">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hyphenationFrequency="none"
                            android:text="@string/home_permission_message"
                            android:textAppearance="?textAppearanceBody1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/permissionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="@string/home_permission_action" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:id="@+id/recentTitle" style="@style/HomeSectionTitle" android:text="@string/home_recent" />
                <TextView
                    android:id="@+id/recentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hyphenationFrequency="none"
                    android:paddingHorizontal="@dimen/space_gutter"
                    android:paddingVertical="@dimen/space_gutter"
                    android:text="@string/home_recent_empty"
                    android:textColor="?android:textColorSecondary"
                    android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentList"
                    android:layoutAnimation="@anim/home_grid_enter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/home_list_padding" />

                <TextView style="@style/HomeSectionTitle" android:text="@string/home_categories" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryList"
                    android:layoutAnimation="@anim/home_grid_enter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/home_list_padding" />

                <!-- Vault and backup side by side as one row of tools: icon left, text beside it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/home_list_padding">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/vaultCard"
                        style="@style/Widget.Ordo.HomeCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/phi_row_min"
                        android:layout_margin="@dimen/home_card_margin"
                        app:cardCornerRadius="@dimen/phi_radius_m"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:stateListAnimator="@animator/home_press_scale">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/phi_8">

                            <ImageView
                                android:id="@+id/vaultIcon"
                                android:layout_width="@dimen/phi_34"
                                android:layout_height="@dimen/phi_34"
                                android:background="@drawable/home_icon_circle"
                                android:contentDescription="@null"
                                android:padding="@dimen/phi_5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/phi_8"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hyphenationFrequency="none"
                                    android:text="@string/navigation_vault"
                                    android:textAppearance="?textAppearanceSubtitle2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hyphenationFrequency="none"
                                    android:maxLines="2"
                                    android:text="@string/home_vault_summary_short"
                                    android:textAppearance="?textAppearanceCaption"
                                    android:textColor="?android:textColorSecondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/backupCard"
                        style="@style/Widget.Ordo.HomeCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/phi_row_min"
                        android:layout_margin="@dimen/home_card_margin"
                        app:cardCornerRadius="@dimen/phi_radius_m"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:stateListAnimator="@animator/home_press_scale">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/phi_8">

                            <ImageView
                                android:id="@+id/backupIcon"
                                android:layout_width="@dimen/phi_34"
                                android:layout_height="@dimen/phi_34"
                                android:background="@drawable/home_icon_circle"
                                android:contentDescription="@null"
                                android:padding="@dimen/phi_5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/phi_8"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hyphenationFrequency="none"
                                    android:text="@string/navigation_backup"
                                    android:textAppearance="?textAppearanceSubtitle2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hyphenationFrequency="none"
                                    android:maxLines="2"
                                    android:text="@string/home_backup_summary_short"
                                    android:textAppearance="?textAppearanceCaption"
                                    android:textColor="?android:textColorSecondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView style="@style/HomeSectionTitle" android:text="@string/home_storage" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/storageList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/home_list_padding" />

                <TextView android:id="@+id/quickAccessTitle" style="@style/HomeSectionTitle" android:text="@string/home_quick_access" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quickAccessList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/home_list_padding" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.ThemedSwipeRefreshLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/toolbarBlur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- One slim row that stays in reach while the content scrolls: side menu, search, assistant, more. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            style="@style/Widget.Ordo.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/space_gutter"
            android:layout_marginVertical="@dimen/space_item"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            app:cardCornerRadius="@dimen/phi_radius_l">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:theme="?actionBarTheme">
                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_navigation_drawer"
                    android:src="@drawable/menu_icon_control_normal_24dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:hyphenationFrequency="none"
                    android:paddingStart="@dimen/phi_5"
                    android:text="@string/home_search_hint"
                    android:textAppearance="?textAppearanceBody1"
                    android:textColor="?android:textColorSecondary" />
                <ImageButton
                    android:id="@+id/assistantButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_open"
                    android:src="@drawable/assistant_icon_white_24dp"
                    android:visibility="gone"
                    app:tint="@color/home_assistant" />
                <ImageButton
                    android:id="@+id/moreButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/abc_action_menu_overflow_description"
                    android:src="@drawable/more_vertical_icon_white_24dp"
                    app:tint="?colorControlNormal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </eightbitlab.com.blurview.BlurView>

    <!-- Soft edge on the content side of the glass bar: content fades out instead of being cut; shown once content lies under the bar. -->
    <View
        android:id="@+id/toolbarEdge"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phi_34"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- With the search bar at the bottom: keeps the status bar readable once the page scrolls under it. -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:visibility="gone" />
    </me.zhanghai.android.files.ui.IgnoreFitsSystemWindowsFullyDraggableDrawerContentLayout>

    <me.zhanghai.android.files.ui.NavigationFrameLayout
        android:id="@+id/navigationFragment"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
