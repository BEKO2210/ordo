<!-- One effect (bass, room sound, width, reverb, warmth, clarity): the ring is the amount, the symbol sits inside it;
     below the title a live picture of what the effect does, its explanation and "−  value  +" in the middle.
     The state line under the title only appears when something else (mono) holds the effect off, or for what an
     effect found (the cut of "Fill in missing highs"). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ordo.Klang.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/klang_effect_card_min_height">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/klang_space_lg"
        android:paddingTop="@dimen/klang_space_md"
        android:paddingEnd="@dimen/klang_space_lg"
        android:paddingBottom="@dimen/klang_space_md">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/klang_touch_target"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="@dimen/klang_icon_column"
                android:layout_height="@dimen/klang_icon_column">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:max="100"
                    app:indicatorColor="?colorPrimary"
                    app:indicatorSize="@dimen/klang_ring_size"
                    app:trackCornerRadius="@dimen/klang_space_xs"
                    app:trackThickness="@dimen/klang_ring_track" />
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/klang_ring_icon_size"
                    android:layout_height="@dimen/klang_ring_icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:tint="?colorPrimary" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/klang_space_sm"
                android:paddingEnd="@dimen/klang_space_sm">
                <TextView
                    android:id="@+id/title"
                    style="@style/Widget.Ordo.Klang.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/state"
                    style="@style/Widget.Ordo.Klang.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/toggle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/klang_touch_target"
                android:gravity="center" />
        </LinearLayout>
        <me.zhanghai.android.files.viewer.audio.KlangPictureView
            android:id="@+id/picture"
            android:layout_width="match_parent"
            android:layout_height="@dimen/klang_picture_height"
            android:layout_marginTop="@dimen/klang_space_md" />
        <TextView
            android:id="@+id/summary"
            style="@style/Widget.Ordo.Klang.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/klang_space_md" />
        <!-- Effect-specific choices (the reverb rooms) go here. -->
        <LinearLayout
            android:id="@+id/extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/klang_space_md"
            android:orientation="vertical"
            android:visibility="gone" />
        <include
            android:id="@+id/stepper"
            layout="@layout/klang_value_stepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/klang_space_sm" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
