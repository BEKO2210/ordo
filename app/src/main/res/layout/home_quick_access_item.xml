<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">
    <ImageView android:id="@+id/iconImage" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" app:tint="?colorControlNormal" />
    <TextView android:id="@+id/nameText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_weight="1" android:maxLines="1" android:textAppearance="?textAppearanceBody1" />
</LinearLayout>
