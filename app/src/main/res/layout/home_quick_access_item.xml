<me.zhanghai.android.files.home.PhiTileCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ordo.HomeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/home_card_margin"
    app:cardCornerRadius="@dimen/phi_radius_m"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    android:stateListAnimator="@animator/home_press_scale">

    <!-- Same tile as the categories; no count, because counting a folder would scan the disk. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/phi_8">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="@dimen/phi_34"
            android:layout_height="@dimen/phi_34"
            android:layout_gravity="top|end"
            android:background="@drawable/home_icon_circle"
            android:contentDescription="@null"
            android:padding="@dimen/phi_5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:textAppearance="?textAppearanceSubtitle2" />
        </LinearLayout>
    </FrameLayout>
</me.zhanghai.android.files.home.PhiTileCardView>
