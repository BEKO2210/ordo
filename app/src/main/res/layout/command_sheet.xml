<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_gutter"
        android:paddingBottom="@dimen/space_section">

        <!-- Only as wide as its touch target, with the rounded house highlight: with a keyboard the default focus
             highlight was a pale band across the sheet. -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ordo_row_ripple"
            android:minWidth="48dp" />

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <me.zhanghai.android.files.ai.AiOrbView
                android:id="@+id/headerOrb"
                android:layout_width="@dimen/phi_55"
                android:layout_height="@dimen/phi_55"
                android:layout_marginEnd="@dimen/space_card_v" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:hyphenationFrequency="none"
                android:text="@string/ai_title"
                android:textAppearance="?textAppearanceHeadline6" />

            <ImageButton
                android:id="@+id/removeModelButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_remove_title"
                android:src="@drawable/delete_icon_white_24dp"
                app:tint="?android:textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related"
            android:hyphenationFrequency="none"
            android:text="@string/ai_subtitle"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />

        <!-- First run: device check and model download -->
        <LinearLayout
            android:id="@+id/setupLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card_h"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/phaseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_card_v"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:hyphenationFrequency="none"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="@color/ai_accent"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="@dimen/phi_144"
                android:layout_height="@dimen/phi_144"
                android:layout_gravity="center_horizontal">

                <me.zhanghai.android.files.ai.AiOrbView
                    android:id="@+id/setupOrb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/percentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:shadowColor="#66000000"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/setupPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_h"
                android:background="@drawable/ai_glass_card"
                android:drawablePadding="@dimen/space_card_v"
                android:gravity="center_vertical"
                android:hyphenationFrequency="none"
                android:paddingHorizontal="@dimen/space_card_h"
                android:paddingVertical="@dimen/space_card_v"
                android:text="@string/ai_setup_privacy"
                android:textAppearance="?textAppearanceBody2"
                app:drawableStartCompat="@drawable/ai_privacy_icon_white_24dp"
                app:drawableTint="@color/ai_accent" />

            <LinearLayout
                android:id="@+id/checkList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_v"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/checkRam"
                    style="@style/Widget.Ordo.AiCheckRow"
                    app:drawableStartCompat="@drawable/ai_memory_icon_white_24dp" />

                <TextView
                    android:id="@+id/checkSpace"
                    style="@style/Widget.Ordo.AiCheckRow"
                    app:drawableStartCompat="@drawable/ai_storage_icon_white_24dp" />

                <TextView
                    android:id="@+id/checkDevice"
                    style="@style/Widget.Ordo.AiCheckRow"
                    app:drawableStartCompat="@drawable/ai_phone_icon_white_24dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/downloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_h"
                android:max="1000"
                android:visibility="gone"
                app:indicatorColor="@color/ai_accent"
                app:trackColor="@color/ai_card"
                app:trackCornerRadius="@dimen/phi_8"
                app:trackThickness="@dimen/phi_8" />

            <TextView
                android:id="@+id/downloadText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_item"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/phi_row_min"
                android:layout_marginTop="@dimen/space_card_h"
                android:backgroundTint="@color/ai_accent"
                android:hyphenationFrequency="none"
                android:textAllCaps="false"
                android:textColor="@color/ai_on_accent"
                android:textSize="16sp"
                app:cornerRadius="@dimen/phi_radius_xl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobileDataButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:minHeight="48dp"
                android:text="@string/ai_mobile_data"
                android:textAllCaps="false"
                android:textColor="@color/ai_accent"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/commandLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card_h"
            android:hint="@string/ai_hint"
            android:visibility="gone"
            app:boxCornerRadiusBottomEnd="@dimen/phi_radius_xl"
            app:boxCornerRadiusBottomStart="@dimen/phi_radius_xl"
            app:boxCornerRadiusTopEnd="@dimen/phi_radius_xl"
            app:boxCornerRadiusTopStart="@dimen/phi_radius_xl"
            app:boxStrokeColor="@color/ai_accent"
            app:endIconContentDescription="@string/ai_send"
            app:endIconDrawable="@drawable/send_icon_white_24dp"
            app:endIconMode="custom"
            app:endIconTint="@color/ai_accent"
            app:hintTextColor="@color/ai_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/commandEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:imeOptions="actionGo"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="@dimen/phi_row_min"
                android:paddingStart="@dimen/space_card_h"
                android:paddingEnd="@dimen/space_item" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:id="@+id/exampleScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_gutter_negative"
            android:layout_marginTop="@dimen/space_item"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_gutter"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/exampleChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- Thinking -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card_h"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <me.zhanghai.android.files.ai.AiOrbView
                android:id="@+id/thinkingOrb"
                android:layout_width="@dimen/phi_89"
                android:layout_height="@dimen/phi_89" />

            <TextSwitcher
                android:id="@+id/loadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_h"
                android:accessibilityLiveRegion="polite"
                android:inAnimation="@anim/ai_text_in"
                android:outAnimation="@anim/ai_text_out" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_item"
                android:hyphenationFrequency="none"
                android:text="@android:string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/ai_accent" />
        </LinearLayout>

        <!-- Question, refusal or error -->
        <LinearLayout
            android:id="@+id/messageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card_h"
            android:background="@drawable/ai_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_card_h"
            android:paddingVertical="@dimen/space_card_v"
            android:visibility="gone">

            <!-- Only for a hint (something Ordo cannot know yet): a bulb that pops in. -->
            <ImageView
                android:id="@+id/messageIcon"
                android:layout_width="@dimen/phi_icon_box"
                android:layout_height="@dimen/phi_icon_box"
                android:layout_marginBottom="@dimen/space_card_v"
                android:background="@drawable/home_icon_circle"
                android:importantForAccessibility="no"
                android:padding="@dimen/phi_5"
                android:visibility="gone" />

            <TextView
                android:id="@+id/messageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceSubtitle1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_related"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/folderChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_item" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hintActionButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_card_v"
                android:backgroundTint="@color/ai_accent"
                android:hyphenationFrequency="none"
                android:textAllCaps="false"
                android:textColor="@color/ai_on_accent"
                android:visibility="gone"
                app:cornerRadius="@dimen/phi_radius_xl" />

            <TextView
                android:id="@+id/hintDismissText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_v"
                android:hyphenationFrequency="none"
                android:text="@string/ai_hint_dismiss"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:hyphenationFrequency="none"
                android:text="@string/ai_retry"
                android:textAllCaps="false"
                android:textColor="@color/ai_accent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Preview -->
        <LinearLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card_h"
            android:background="@drawable/ai_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_card_h"
            android:paddingVertical="@dimen/space_card_v"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/actionIcon"
                    android:layout_width="@dimen/phi_icon_box"
                    android:layout_height="@dimen/phi_icon_box"
                    android:layout_marginEnd="@dimen/space_card_v"
                    android:background="@drawable/home_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/phi_5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/actionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:hyphenationFrequency="none"
                        android:textAppearance="?textAppearanceSubtitle1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/routeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_related"
                        android:hyphenationFrequency="none"
                        android:textAppearance="?textAppearanceCaption"
                        android:textColor="?android:textColorSecondary" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_v" />

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_v"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceSubtitle2" />

            <TextView
                android:id="@+id/fileListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_related"
                android:hyphenationFrequency="none"
                android:lineSpacingMultiplier="1.25"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />

            <TextView
                android:id="@+id/noteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_v"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone" />

            <!-- Stacked and full width: long German labels fit on 360 dp and at large font sizes. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card_h"
                android:hyphenationFrequency="none"
                android:minHeight="@dimen/phi_row_min"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/phi_radius_xl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:minHeight="48dp"
                android:text="@string/ai_edit"
                android:textAllCaps="false"
                android:textColor="@color/ai_accent" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
