<!-- Edge to edge over a black window; VideoPlayerActivity pads the controls by the system bars. Sizes come from the
     music player's dimens, which already grow on tablets (sw600dp/w600dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:importantForAccessibility="yes"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="@android:color/transparent"
            android:theme="?actionBarTheme"
            app:menu="@menu/video_player"
            app:navigationContentDescription="@string/video_player_back"
            app:navigationIcon="?homeAsUpIndicator"
            app:popupTheme="?actionBarPopupTheme" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/rewind" style="@style/Widget.Ordo.AudioPlayer.SkipControl"
                android:contentDescription="@string/video_player_rewind" android:src="@drawable/video_replay_10_icon_24dp" />
            <Space android:layout_width="24dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/playPause" style="@style/Widget.Ordo.AudioPlayer.PrimaryControl"
                android:contentDescription="@string/video_player_pause" android:src="@drawable/pause_icon_24dp" />
            <Space android:layout_width="24dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/forward" style="@style/Widget.Ordo.AudioPlayer.SkipControl"
                android:contentDescription="@string/video_player_forward" android:src="@drawable/video_forward_10_icon_24dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/elapsed"
                    style="@style/Widget.Ordo.AudioPlayer.Time"
                    android:layout_width="wrap_content"
                    android:layout_weight="0"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="56dp"
                    android:minHeight="48dp"
                    android:textColor="?colorOnSurface"
                    android:text="0:00" />
                <me.zhanghai.android.files.viewer.audio.PlayerSeekSlider
                    android:id="@+id/seekBar"
                    style="@style/Widget.Ordo.AudioPlayer.Seek"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/video_player_position" />
                <TextView
                    android:id="@+id/duration"
                    style="@style/Widget.Ordo.AudioPlayer.Time"
                    android:layout_width="wrap_content"
                    android:layout_weight="0"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:textColor="?colorOnSurface"
                    android:text="0:00" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageButton android:id="@+id/speed" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_speed" android:src="@drawable/audio_speed_icon_24dp" />
                <ImageButton android:id="@+id/resize" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_resize"
                    android:src="@drawable/video_aspect_ratio_icon_24dp" />
                <ImageButton android:id="@+id/lock" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_lock" android:src="@drawable/lock_open_icon_white_24dp" />
                <ImageButton android:id="@+id/rotate" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_rotate"
                    android:src="@drawable/video_screen_rotation_icon_24dp" />
                <ImageButton android:id="@+id/previous" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_previous" android:src="@drawable/skip_previous_icon_24dp" />
                <ImageButton android:id="@+id/next" style="@style/Widget.Ordo.AudioPlayer.SecondaryControl"
                    android:contentDescription="@string/video_player_next" android:src="@drawable/skip_next_icon_24dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- "+20 s" after quick taps, "Fill" after the picture format changed: one short line on the side or centre. -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/audio_player_seek_bubble"
        android:backgroundTint="#cc202020"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="?textAppearanceSubtitle2"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resumePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:minHeight="48dp"
        android:visibility="gone"
        app:cornerRadius="24dp"
        app:icon="@drawable/play_icon_24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlock"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:minHeight="56dp"
        android:text="@string/video_player_unlock_hint"
        android:visibility="gone"
        app:cornerRadius="28dp"
        app:icon="@drawable/lock_icon_white_24dp" />

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?colorOnSurface" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorOpenWith"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/video_player_open_with" />
    </LinearLayout>
</FrameLayout>
