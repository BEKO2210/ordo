<?xml version="1.0" encoding="utf-8"?>
<!-- Sound controls deliberately avoid sliders: EQ dragging arms after 150 ms; every value has steppers. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/audio_sound_title"
                android:textAppearance="?textAppearanceHeadline6" />

            <ImageButton
                android:id="@+id/close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="12dp"
                android:src="@drawable/close_icon_control_normal_24dp"
                app:tint="?colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/effectStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/audio_sound_checking"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="?android:textColorSecondary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/equalizerEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_sound_equalizer" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/audio_sound_curve_hint"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />

        <me.zhanghai.android.files.viewer.audio.EqualizerCurveView
            android:id="@+id/equalizerCurve"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <LinearLayout
            android:id="@+id/bandSteppers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/preGainRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/bassSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bassEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/audio_sound_bass_boost" />
            <LinearLayout
                android:id="@+id/bassStrengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/virtualizerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/virtualizerEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/audio_sound_virtualizer" />
            <LinearLayout
                android:id="@+id/virtualizerStrengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/audio_sound_normalization_heading"
            android:textAppearance="?textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/normalizationEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_sound_normalization" />

        <LinearLayout
            android:id="@+id/normalizationPreampRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/audio_sound_playback_heading"
            android:textAppearance="?textAppearanceSubtitle1"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/speedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/skipSilence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_sound_skip_silence" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_sound_mono" />

        <LinearLayout
            android:id="@+id/balanceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/audio_sound_focus_heading"
            android:textAppearance="?textAppearanceBody1"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/focusBehavior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/focusDuck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/audio_sound_focus_duck" />
            <RadioButton
                android:id="@+id/focusPause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/audio_sound_focus_pause" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/resumeHeadphones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_sound_resume_headphones" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/audio_sound_sleep_heading"
            android:textAppearance="?textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sleepOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp"
            app:singleSelection="true" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
