<!-- Ordo Music with Ordo's side menu: the library (music_library_content) and, as in the file list, the menu that
     slides in from the start. From 840 dp width (tablets in landscape) it stays open beside the library (layout-w840dp). -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/content"
        layout="@layout/music_library_content" />

    <!-- fitsSystemWindows keeps DrawerLayout from turning the window insets into margins of the menu. -->
    <me.zhanghai.android.files.ui.NavigationFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?colorSurface"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/navigation"
            layout="@layout/navigation_fragment" />
    </me.zhanghai.android.files.ui.NavigationFrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
