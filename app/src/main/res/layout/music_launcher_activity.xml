<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/Widget.Ordo.AudioPlayer.Title"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="start"
        android:text="@string/launcher_music_start_title" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Widget.Ordo.AudioPlayer.Subtitle"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:gravity="start"
        android:text="@string/launcher_music_start_subtitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyText"
            style="@style/Widget.Ordo.AudioPlayer.Subtitle"
            android:layout_gravity="center"
            android:maxLines="4"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/launcher_music_start_empty"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chooseFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="56dp"
        android:text="@string/launcher_music_choose_folder"
        app:icon="@drawable/directory_icon_white_24dp" />
</LinearLayout>
