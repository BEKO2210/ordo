<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overviewScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_section">

    <!-- One column of cards on a phone. On a wide screen the dashboard moves half of them into the second column. -->
    <LinearLayout
        android:id="@+id/overviewColumns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_gutter"
        android:paddingTop="@dimen/space_item">

    <LinearLayout
        android:id="@+id/columnA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Usage: your files, system and free in one bar -->
        <LinearLayout
            android:id="@+id/usageCard"
            style="@style/Widget.Ordo.DashboardCard">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:text="@string/analysis_usage_title" />

            <TextView
                android:id="@+id/usageHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_related"
                android:textAppearance="?textAppearanceHeadline3" />

            <TextView
                android:id="@+id/usageSubtitle"
                style="@style/Widget.Ordo.DashboardSubtitle" />

            <me.zhanghai.android.files.analysis.StackedBarView
                android:id="@+id/usageBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phi_13"
                android:layout_marginTop="@dimen/space_gutter"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/usageLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_item"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Your files by type -->
        <LinearLayout
            android:id="@+id/filesCard"
            style="@style/Widget.Ordo.DashboardCard">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:text="@string/analysis_kind_mine" />

            <TextView
                style="@style/Widget.Ordo.DashboardSubtitle"
                android:text="@string/analysis_files_subtitle" />

            <!-- The ring above its rows; next to them where the card is wide enough. -->
            <LinearLayout
                android:id="@+id/filesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <me.zhanghai.android.files.analysis.DonutView
                    android:id="@+id/filesChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/phi_233"
                    android:layout_marginTop="@dimen/space_item" />

                <LinearLayout
                    android:id="@+id/filesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cleanup -->
        <LinearLayout
            android:id="@+id/cleanupCard"
            style="@style/Widget.Ordo.DashboardCard">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:text="@string/analysis_cleanup_title" />

            <TextView
                android:id="@+id/cleanupHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_related"
                android:textAppearance="?textAppearanceHeadline5"
                android:textStyle="bold" />

            <me.zhanghai.android.files.analysis.StackedBarView
                android:id="@+id/cleanupBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_item"
                android:layout_marginTop="@dimen/space_card_v"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/cleanupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Suggestions -->
        <LinearLayout
            android:id="@+id/suggestionCard"
            style="@style/Widget.Ordo.DashboardCard"
            android:visibility="gone">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:drawablePadding="@dimen/space_item"
                android:text="@string/analysis_suggestions_title"
                app:drawableStartCompat="@drawable/assistant_icon_white_24dp"
                app:drawableTint="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/suggestionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Biggest folders as ranked bars -->
        <LinearLayout
            android:id="@+id/folderCard"
            style="@style/Widget.Ordo.DashboardCard">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:text="@string/analysis_treemap_title" />

            <TextView
                style="@style/Widget.Ordo.DashboardSubtitle"
                android:text="@string/analysis_treemap_subtitle" />

            <!-- The map above the rows; next to them where the card is wide enough. -->
            <LinearLayout
                android:id="@+id/folderBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/folderMapBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <me.zhanghai.android.files.analysis.TreemapView
                        android:id="@+id/folderMap"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/phi_233"
                        android:layout_marginTop="@dimen/space_card_v" />

                    <!-- What the marked tile is, as a row that opens it. -->
                    <LinearLayout
                        android:id="@+id/folderPick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_related"
                        android:minHeight="@dimen/phi_row_min"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folderList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_related"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Growth -->
        <LinearLayout
            android:id="@+id/growthCard"
            style="@style/Widget.Ordo.DashboardCard">

            <TextView
                style="@style/Widget.Ordo.DashboardTitle"
                android:text="@string/analysis_growth_title" />

            <TextView
                android:id="@+id/growthSubtitle"
                style="@style/Widget.Ordo.DashboardSubtitle" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/growthChart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phi_233"
                android:layout_marginTop="@dimen/space_item" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/columnB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_gutter"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
