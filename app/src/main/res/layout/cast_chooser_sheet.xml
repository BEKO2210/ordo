<!-- Cast chooser: a calm search animation, this phone and every cast device on the Wi-Fi. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/phi_21"
        android:paddingTop="@dimen/phi_13"
        android:paddingEnd="@dimen/phi_21"
        android:paddingBottom="@dimen/phi_34">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:text="@string/cast_title"
            android:textAppearance="?textAppearanceHeadline6"
            android:textColor="?colorOnSurface" />

        <me.zhanghai.android.files.viewer.audio.CastSearchView
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phi_89"
            android:layout_marginTop="@dimen/phi_8"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:text="@string/cast_searching"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="?android:textColorSecondary" />

        <LinearLayout
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_13"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/effectsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_8"
            android:hyphenationFrequency="none"
            android:text="@string/cast_effects_note"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop"
            style="?materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/phi_13"
            android:minHeight="48dp"
            android:text="@string/cast_stop"
            android:visibility="gone"
            app:icon="@drawable/close_icon_control_normal_24dp" />

        <TextView
            android:id="@+id/privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_21"
            android:drawablePadding="@dimen/phi_8"
            android:hyphenationFrequency="none"
            android:text="@string/cast_privacy"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
