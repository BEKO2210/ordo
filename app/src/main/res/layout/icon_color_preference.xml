<!-- The icon as the launcher gets it (55 dp), its name and the chosen colour's name with a dot of that colour, so the
     choice can be read without telling colours apart. Below, the swatches fill the row's width (filled in code):
     four per line on phones, all eight in one line from about 470 dp. φ: 13 dp between blocks, 55 dp touch cells. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingTop="@dimen/space_card_v"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="@dimen/space_card_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon_preview"
            android:layout_width="@dimen/phi_55"
            android:layout_height="@dimen/phi_55"
            android:layout_marginEnd="@dimen/space_card_v"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceSubtitle1" />
            <TextView
                android:id="@+id/color_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_related"
                android:drawablePadding="@dimen/space_item"
                android:gravity="center_vertical"
                android:textAppearance="?textAppearanceSubtitle2"
                android:textColor="?android:textColorPrimary" />
            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/swatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_item"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical" />
</LinearLayout>
