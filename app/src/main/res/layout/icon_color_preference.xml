<!-- Like accent_preference: the live icon in AndroidX's 56 dp icon column (48 dp, the size a launcher shows it, plus
     the 8 dp gap), so the text edge is the page's. Swatches: 34 dp circles in 55 dp cells, four per line; the first
     cell starts 45.5 dp in (56 - (55 - 34) / 2) so its circle sits on the text edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="@dimen/space_card_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_card_v">

        <ImageView
            android:id="@+id/icon_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/space_item"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceSubtitle1" />
            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filled in code: one 55 dp round touch target per colour. -->
    <GridLayout
        android:id="@+id/swatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45.5dp"
        android:layout_marginTop="@dimen/space_related"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:columnCount="4" />
</LinearLayout>
