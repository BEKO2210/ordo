<!-- Header like a standard preference row (icon centred on title and summary), the colour controls below it on
     the text edge. Measure: φ scale. The icon column keeps AndroidX's 56 dp (icon_frame) so the text edge is the
     page's. Swatches: 34 dp circle in a 55 dp cell; the first cell starts 45.5 dp in (56 - (55 - 34) / 2) so its
     circle, not its cell, sits on the text edge. Nothing clips: the 3 dp ring gap stays inside the cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="@dimen/space_item">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_card_v">

        <!-- The icon column of AndroidX Preference (image_frame), so the text edge is the page's. -->
        <LinearLayout
            android:id="@+id/icon_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:minWidth="56dp"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/space_item">
            <ImageView
                android:id="@android:id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:maxWidth="@dimen/phi_55"
                android:maxHeight="@dimen/phi_55" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceSubtitle1" />
            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filled in code: one 55 dp round touch target per accent. -->
    <LinearLayout
        android:id="@+id/swatches"
        android:layout_marginStart="45.5dp"
        android:layout_marginTop="@dimen/space_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <me.zhanghai.android.files.colorpicker.ColorPreviewView
        android:id="@+id/accent_preview"
        android:layout_width="@dimen/phi_144"
        android:layout_height="@dimen/phi_89"
        android:layout_marginStart="56dp"
        android:layout_marginTop="@dimen/space_card_v"
        android:importantForAccessibility="no" />
</LinearLayout>
