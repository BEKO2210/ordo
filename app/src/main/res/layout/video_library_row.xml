<!-- One video in the list view (Ordo Video's settings › View): the 16:9 picture on the start side, name and second
     line beside it. Same ids as video_library_item.xml, so both bind alike. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/phi_5"
    android:paddingBottom="@dimen/phi_5">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="144dp"
        android:layout_height="81dp"
        android:importantForAccessibility="noHideDescendants"
        app:cardBackgroundColor="?colorSurfaceVariant"
        app:cardCornerRadius="@dimen/phi_8"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/phi_5"
            android:background="@drawable/audio_player_seek_bubble"
            android:backgroundTint="#b3000000"
            android:fontFeatureSettings="tnum"
            android:paddingStart="@dimen/phi_5"
            android:paddingEnd="@dimen/phi_5"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="@android:color/white" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:max="1000"
            android:visibility="gone"
            app:trackCornerRadius="0dp"
            app:trackThickness="4dp" />

        <!-- Never started (VideoLauncherActivity): a small accent dot; selected: a check on the picture. -->
        <View
            android:id="@+id/unwatchedDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/phi_8"
            android:background="@drawable/video_library_dot"
            android:backgroundTint="?colorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/selectedCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/phi_5"
            android:contentDescription="@null"
            android:src="@drawable/check_circle_icon_white_24dp"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/phi_13"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_5"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
</LinearLayout>
