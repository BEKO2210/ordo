<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/close_icon_control_normal_24dp"
        app:popupTheme="?actionBarPopupTheme" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF5F6368" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/screen_edge_margin"
        android:text="@string/pdf_viewer_error"
        android:textAppearance="?textAppearanceListItem"
        android:visibility="gone" />
</LinearLayout>
