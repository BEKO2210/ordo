<!-- Above a list of songs: "Shuffle all (N)" alone on the Songs tab, "Play" and "Shuffle" side by side in an album,
     artist or folder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_gutter"
    android:paddingTop="@dimen/phi_8"
    android:paddingEnd="@dimen/space_gutter"
    android:paddingBottom="@dimen/phi_8">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/phi_8"
        android:layout_weight="1"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        android:minHeight="@dimen/phi_55"
        android:text="@string/audio_player_play"
        app:cornerRadius="@dimen/phi_radius_l"
        app:icon="@drawable/play_icon_24dp"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shuffle"
        style="?materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        android:minHeight="@dimen/phi_55"
        android:text="@string/audio_player_shuffle"
        app:cornerRadius="@dimen/phi_radius_l"
        app:icon="@drawable/shuffle_icon_24dp"
        app:iconGravity="textStart" />
</LinearLayout>
