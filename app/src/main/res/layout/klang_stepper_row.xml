<!-- Label, value pill and connected minus / plus: one band, the pre-gain, the normalisation pre-amp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="8dp"
        android:textAppearance="@style/TextAppearance.Ordo.Klang.Body" />
    <TextView
        android:id="@+id/stepValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textAppearance="@style/TextAppearance.Ordo.Klang.Label" />
    <include
        android:id="@+id/steps"
        layout="@layout/klang_step_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
