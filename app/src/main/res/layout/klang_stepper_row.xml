<!-- Label, value pill and connected minus / plus: one band, the pre-gain, the normalisation pre-amp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/klang_row_min_height"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/stepLabel"
        style="@style/Widget.Ordo.Klang.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="@dimen/klang_space_sm" />
    <TextView
        android:id="@+id/stepValue"
        style="@style/Widget.Ordo.Klang.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <include
        android:id="@+id/steps"
        layout="@layout/klang_step_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/klang_space_sm"
        android:layout_marginEnd="@dimen/klang_step_edge" />
</LinearLayout>
