<me.zhanghai.android.files.home.PhiTileCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ordo.HomeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/home_card_margin"
    app:cardCornerRadius="@dimen/phi_radius_m"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    android:stateListAnimator="@animator/home_press_scale">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <me.zhanghai.android.files.home.PhiImageView
            android:id="@+id/thumbnailImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/file_generic_icon" />
        <TextView
            android:id="@+id/nameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/phi_8"
            android:paddingVertical="@dimen/phi_5"
            android:textAppearance="?textAppearanceCaption" />
    </LinearLayout>
</me.zhanghai.android.files.home.PhiTileCardView>
