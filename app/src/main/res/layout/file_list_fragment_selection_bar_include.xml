<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Labeled actions at thumb reach while files are selected, like Samsung My Files. -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?colorSurface"
        android:elevation="8dp"
        android:fitsSystemWindows="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/phi_5">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionMoveButton"
                style="@style/Widget.Ordo.SelectionBarButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionCopyButton"
                style="@style/Widget.Ordo.SelectionBarButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionShareButton"
                style="@style/Widget.Ordo.SelectionBarButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionDeleteButton"
                style="@style/Widget.Ordo.SelectionBarButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectionMoreButton"
                style="@style/Widget.Ordo.SelectionBarButton" />
        </LinearLayout>

        <!-- Hairline that separates the glass bar from the list. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?colorControlHighlight" />
    </eightbitlab.com.blurview.BlurView>
</merge>
