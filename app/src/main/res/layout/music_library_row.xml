<!-- A song, an artist or a folder: cover (or track number), title, an info line if it says something new, and
     for songs the duration and a ⋮ menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/phi_55"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_gutter"
    android:paddingTop="@dimen/phi_8"
    android:paddingEnd="@dimen/space_gutter"
    android:paddingBottom="@dimen/phi_8">

    <include
        android:id="@+id/art"
        layout="@layout/music_art" />

    <!-- On an album page the track number stands where the (same) cover would repeat; the playing song shows
         moving bars instead. -->
    <FrameLayout
        android:id="@+id/numberSlot"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <TextView
            android:id="@+id/number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?android:textColorSecondary" />

        <me.zhanghai.android.files.viewer.audio.EqualizerBarsView
            android:id="@+id/slotBars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_card_v"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_3"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_card_v"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:textColorSecondary" />

    <ImageButton
        android:id="@+id/more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/phi_5"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/more_vertical_icon_white_24dp"
        android:visibility="gone"
        app:tint="?colorControlNormal" />
</LinearLayout>
