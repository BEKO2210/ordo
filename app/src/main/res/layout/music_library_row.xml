<!-- A song, an artist or a folder: cover, title, one info line, and the duration for songs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/phi_55"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_gutter"
    android:paddingTop="@dimen/phi_8"
    android:paddingEnd="@dimen/space_gutter"
    android:paddingBottom="@dimen/phi_8">

    <include
        android:id="@+id/art"
        layout="@layout/music_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_card_v"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?colorOnSurface" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/phi_3"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:textAppearance="?textAppearanceCaption"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_card_v"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:textColorSecondary" />
</LinearLayout>
