<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?actionBarSize" android:background="?colorAppBarSurface"
        android:title="@string/audio_player_title" android:theme="?actionBarTheme"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/close_icon_control_normal_24dp"
        app:popupTheme="?actionBarPopupTheme" />

    <!-- Scrolls on a landscape phone, where the controls would not fit; fillViewport keeps the artwork flexible. -->
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_edge_margin" android:paddingEnd="@dimen/screen_edge_margin"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp"
            android:layout_weight="1" android:minHeight="120dp"
            app:cardBackgroundColor="?colorSurfaceVariant" app:cardElevation="0dp">
            <ImageView android:id="@+id/artwork" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@null"
                android:importantForAccessibility="no" android:scaleType="centerInside" />
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center"
            android:maxLines="2" android:textAppearance="?textAppearanceHeadline6"
            android:textColor="?colorOnSurface" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:ellipsize="end" android:gravity="center" android:maxLines="1"
            android:textAppearance="?textAppearanceBody1" android:textColor="?android:textColorSecondary" />
        <TextView android:id="@+id/album" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:ellipsize="end" android:gravity="center" android:maxLines="1"
            android:textAppearance="?textAppearanceBody2" android:textColor="?android:textColorSecondary" />

        <SeekBar android:id="@+id/seekBar" android:layout_width="match_parent"
            android:layout_height="48dp" android:contentDescription="@string/audio_player_position"
            android:max="1000" android:paddingStart="0dp" android:paddingEnd="0dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/elapsed" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:importantForAccessibility="no" android:fontFamily="sans-serif-medium"
                android:text="0:00" android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />
            <TextView android:id="@+id/remaining" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:importantForAccessibility="no" android:fontFamily="sans-serif-medium"
                android:gravity="end" android:text="−0:00" android:textAppearance="?textAppearanceCaption"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
            android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/shuffle" android:accessibilityLiveRegion="polite" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/audio_player_shuffle" android:padding="12dp"
                android:src="@drawable/shuffle_icon_24dp" android:tint="?colorOnSurface" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/previous" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/audio_player_previous" android:padding="12dp"
                android:src="@drawable/skip_previous_icon_24dp" android:tint="?colorOnSurface" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/playPause" android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/audio_player_primary_control_background"
                android:contentDescription="@string/audio_player_play" android:padding="18dp"
                android:src="@drawable/play_icon_24dp" android:tint="?colorOnPrimary" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/audio_player_next" android:padding="12dp"
                android:src="@drawable/skip_next_icon_24dp" android:tint="?colorOnSurface" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/repeat" android:accessibilityLiveRegion="polite" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/audio_player_repeat" android:padding="12dp"
                android:src="@drawable/repeat_icon_24dp" android:tint="?colorOnSurface" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
