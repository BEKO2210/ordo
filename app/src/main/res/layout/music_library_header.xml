<!-- Top of an album, artist or folder page: a big cover (the code sizes it), the name, who, and "N songs · length". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_gutter"
    android:paddingTop="@dimen/phi_21"
    android:paddingEnd="@dimen/space_gutter"
    android:paddingBottom="@dimen/phi_8">

    <include
        android:id="@+id/art"
        layout="@layout/music_art" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/phi_21"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="?textAppearanceHeadline5"
        android:textColor="?colorOnSurface" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/phi_5"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?textAppearanceBody1"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/phi_3"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?textAppearanceCaption"
        android:textColor="?android:textColorSecondary" />
</LinearLayout>
