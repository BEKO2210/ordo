<!-- One preset, 89 × 55 dp (φ : 1): its curve as a small picture above its name. Selected: container colours and rounder corners. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile"
    style="@style/Widget.Ordo.Klang.PresetTile"
    android:layout_width="@dimen/klang_tile_w"
    android:layout_height="@dimen/klang_tile_h">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/klang_space_xs"
        android:paddingTop="@dimen/klang_space_xs"
        android:paddingEnd="@dimen/klang_space_xs"
        android:paddingBottom="@dimen/klang_space_xs">
        <ImageView
            android:id="@+id/curve"
            android:layout_width="@dimen/klang_tile_curve_w"
            android:layout_height="@dimen/klang_tile_curve_h"
            android:importantForAccessibility="no"
            android:scaleType="center" />
        <TextView
            android:id="@+id/name"
            style="@style/Widget.Ordo.Klang.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Ordo.Klang.Label"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/check"
        android:layout_width="@dimen/klang_tile_check"
        android:layout_height="@dimen/klang_tile_check"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/klang_space_xs"
        android:importantForAccessibility="no"
        android:src="@drawable/check_icon_control_normal_24dp"
        android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
