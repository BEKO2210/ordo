<!-- Icon and text line up with the icons and names of the file rows below. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ordo.HomeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_gutter"
    android:layout_marginTop="@dimen/space_item"
    android:layout_marginBottom="@dimen/space_item">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_card_h"
        android:paddingVertical="@dimen/space_card_v">

        <ImageView
            android:layout_width="@dimen/phi_icon_box"
            android:layout_height="@dimen/phi_icon_box"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_related"
            android:src="@drawable/information_icon_white_24dp"
            app:tint="?colorControlNormal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_item"
            android:hyphenationFrequency="none"
            android:layout_weight="1"
            android:text="@string/vault_notice"
            android:textColor="?android:textColorSecondary"
            android:textAppearance="?textAppearanceCaption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
