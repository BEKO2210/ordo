<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/file_properties_media_address_show"
        android:textAllCaps="false"
        android:textColor="?colorOnPrimaryContainer"
        app:backgroundTint="?colorPrimaryContainer"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_place_24dp"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:iconTint="?colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/file_properties_media_address_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textIsSelectable="true"
        android:visibility="gone" />
</LinearLayout>
