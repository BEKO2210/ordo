<!-- The four reverb rooms in two rows of two: "Konzertsaal" does not fit a quarter of a phone card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/roomsSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spacing="2dp"
        app:innerCornerSize="6dp"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/room0"
            style="@style/Widget.Ordo.Klang.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_reverb_room" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/room1"
            style="@style/Widget.Ordo.Klang.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_reverb_studio" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/roomsLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/klang_space_xs"
        android:spacing="2dp"
        app:innerCornerSize="6dp"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/room2"
            style="@style/Widget.Ordo.Klang.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_reverb_club" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/room3"
            style="@style/Widget.Ordo.Klang.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_reverb_hall" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
