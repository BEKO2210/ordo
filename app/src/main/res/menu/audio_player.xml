<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/actionCast"
        android:icon="@drawable/cast_tv_icon_24dp"
        android:title="@string/cast_title"
        app:showAsAction="always" />
    <item
        android:id="@+id/actionOutput"
        android:icon="@drawable/audio_output_icon_24dp"
        android:title="@string/audio_output_title"
        app:showAsAction="always" />
    <!-- Only when the song has lyrics (a .lrc beside it or embedded). Lyrics and queue are also labelled pills under
         the title (AudioPlayerActivity.setUpPills); here they stay reachable from the overflow. -->
    <item
        android:id="@+id/actionLyrics"
        android:icon="@drawable/tag_lyrics_icon_white_24dp"
        android:title="@string/music_lyrics"
        android:visible="false"
        app:iconTint="?colorControlNormal"
        app:showAsAction="never" />
    <item
        android:id="@+id/actionQueue"
        android:icon="@drawable/queue_music_icon_white_24dp"
        android:title="@string/music_queue"
        app:iconTint="?colorControlNormal"
        app:showAsAction="never" />
    <item
        android:id="@+id/actionSound"
        android:icon="@drawable/equalizer_icon_24dp"
        android:title="@string/audio_sound_title"
        app:showAsAction="always" />
    <!-- The heart: the song in Ordo Music's favourites (Music/Playlists/Favorites.m3u8). Own files only. -->
    <item
        android:id="@+id/actionFavorite"
        android:icon="@drawable/favorite_border_icon_white_24dp"
        android:title="@string/music_favorite_add"
        android:visible="false"
        app:iconTint="?colorControlNormal"
        app:showAsAction="always" />
    <!-- Only for Ordo's own files: a content:// song of another app is read-only. -->
    <item
        android:id="@+id/actionEditTags"
        android:icon="@drawable/tag_edit_icon_white_24dp"
        android:title="@string/music_edit_tags"
        app:iconTint="?colorControlNormal"
        android:visible="false"
        app:showAsAction="never" />
</menu>
