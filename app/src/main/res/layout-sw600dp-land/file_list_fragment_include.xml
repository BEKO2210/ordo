<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <me.zhanghai.android.files.ui.PersistentBarLayout
        android:id="@+id/persistentBarLayout"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

            <include layout="@layout/file_list_fragment_app_bar_include" />

            <me.zhanghai.android.files.ui.PersistentDrawerLayout
                android:id="@+id/persistentDrawerLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <me.zhanghai.android.files.ui.NavigationFrameLayout
                    android:id="@+id/navigationFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="?colorSurface" />

                <!-- One content child: PersistentDrawerLayout takes only start/end drawers besides it, so the
                     bar at the bottom crashed on a tablet in landscape as soon as a file was selected. Here it
                     floats over the list, as on the phone, and stays clear of the navigation pane. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <include layout="@layout/file_list_fragment_content_include" />

                    <include layout="@layout/file_list_fragment_selection_bar_include" />
                </FrameLayout>
            </me.zhanghai.android.files.ui.PersistentDrawerLayout>
        </LinearLayout>

        <include layout="@layout/file_list_fragment_bottom_bar_include" />

        <include layout="@layout/file_list_fragment_speed_dial_include" />
    </me.zhanghai.android.files.ui.PersistentBarLayout>
</merge>
