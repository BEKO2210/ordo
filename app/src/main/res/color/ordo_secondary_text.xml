<!-- Secondary text in Ordo's Material 3 themes: onSurfaceVariant instead of the library's outline colour, which
     reaches only ~3.9:1 on light cards (WCAG asks 4.5:1 for text). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:alpha="0.38" android:color="?attr/colorOnSurface" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
